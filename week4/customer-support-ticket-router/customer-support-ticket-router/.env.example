# Copy this file to .env and fill in your Azure OpenAI deployment details.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-secret-key
AZURE_OPENAI_API_VERSION=replace-with-supported-api-version
AZURE_OPENAI_DEPLOYMENT=replace-with-your-deployment-name
