# Copy to .env (same folder as the notebooks) and fill in. Never commit .env.
# Azure OpenAI v1 API: the notebook calls <endpoint>/openai/v1/ with your chat deployment.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>

# Optional: use a local model instead (Ollama on http://localhost:11434)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
